# Database Configuration
# For MySQL with Docker (recommended)
DATABASE_URL=mysql+pymysql://aqeel:aqeel123@localhost:3307/th_back

# For PostgreSQL (alternative)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcq_db

# Test Database (optional)
TEST_DATABASE_URL=mysql+pymysql://aqeel:aqeel123@localhost:3307/th_back_test

# Environment
ENV=development

# GitHub Models (LLM provider)
GITHUB_TOKEN=your_github_token_here
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
MODEL=openai/gpt-4.1

# Hugging Face (image generation + background removal)
HF_TOKEN=your_huggingface_token_here

# Web Search (multi-backend: Tavily → DuckDuckGo → Brave)
# Tavily: https://app.tavily.com (1000 queries/month free)
TAVILY_API_KEY=your_tavily_api_key_here
# Brave: https://api.search.brave.com ($5 credit/month free)
BRAVE_API_KEY=your_brave_api_key_here
# DuckDuckGo: No API key needed (uses ddgs package)

# Social Login (OAuth)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Newspaper API Acquisition Configuration
NEW_API_URL=http://localhost:5000

# FastAPI Configuration
API_HOST=localhost
API_PORT=8000
API_BASE_URL=http://localhost:8000

# MCP Server Configuration
MCP_SERVER_NAME=ppsc-paper-bank-mcp
MCP_TIMEOUT=60

# Scraping Configuration
MAX_PAGES_PER_CHUNK=50
DEFAULT_REQUEST_TIMEOUT=30

# Paper Series Scheduler
PAPER_SERIES_SCHEDULER_ENABLED=1
PAPER_SERIES_SCHEDULER_TZ=Asia/Karachi

# Email Delivery (optional)
EMAIL_ENABLED=0
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your_email_username
EMAIL_SMTP_PASSWORD=your_email_password
EMAIL_FROM=your_email@example.com
EMAIL_USE_TLS=1
# Optional fallback list if creator email is unavailable
# Comma-separated emails, e.g. a@example.com,b@example.com
EMAIL_RECIPIENTS=

